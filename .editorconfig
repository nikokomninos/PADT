root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cc,cpp,cxx,h,hpp,hxx}]
tab_width = 2
max_line_length = 80

[{CMakeLists.txt,*.cmake}]
indent_size = 2

[*.json]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
